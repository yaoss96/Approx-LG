# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]

# --- native toolchain -----------------------------------------------------
# OSS CAD Suite (yosys, abc, iverilog) is fetched separately, see README.
oss-cad-suite/
oss-cad-suite*.tgz

# --- standard-cell library ------------------------------------------------
# The Nangate45 Liberty file is third-party and carries its own licence
# header, so it is not redistributed here.  See lib/README.md.
lib/*.lib
lib/*.v
lib/nangate45.json

# --- experiment data ------------------------------------------------------
# Left out of the repository: rebuilt by the scripts, or too large to ship.
# Per-design evaluation cache, rebuilt by run_search.py:
results/designs_*.jsonl
# Raw LLM request/response transcripts:
results/llm_*.jsonl
# Synthesis cache, keyed by netlist SHA-1 (the small libs one is kept):
results/ppa_cache_*.json
!results/ppa_cache_libs.json
# Gate-level JSON of third-party RTL, MNIST download, old snapshots:
results/libjson/
results/mnist/
results/backup/
# Run logs, they contain machine-local absolute paths:
results/log_*.txt

# --- paper build artefacts ------------------------------------------------
paper/main_build.*
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/Approx-LG.pdf

# --- misc -----------------------------------------------------------------
.DS_Store
*.swp

# Superseded IEEE-conference draft; the live source is paper/main.tex.
paper/main_ieee_conference.tex

# Camera-ready author block, kept out of the anonymised mirror.
paper/authors_cameraready.tex

# Separate title page uploaded to Manuscript Central.  It carries the author
# names, affiliations and the corresponding author's phone number, and §4.1
# points reviewers at an anonymous mirror of this repository, so committing it
# would deanonymise the submission.  (paper/*.aux, *.log and *.out are already
# ignored above; the .pdf is not, hence the explicit line.)
paper/title_page.tex
paper/title_page.pdf

# draw.io desktop writes these beside the file it is editing.
.$*.bkp
*.drawio.bkp
*.drawio.dtmp

# Submission packages are build artefacts; scripts/make_submission.py makes them.
paper/submission/

# --- TCAD revision ----------------------------------------------------------
# Per-design netlists and simulation dumps of the glitch analysis, rebuilt by
# scripts/analyze_glitch.py:
results/glitch_work/
# Backups kept beside a repaired cache (see results/repairs.txt):
results/*.bak_*
# Smoke test of the multi-objective drivers, not a campaign:
results/search_n8mootest.jsonl
# Gurobi writes its log into the working directory:
gurobi.log
# Manuscript build artefacts and the submission bundle
# (scripts/package_tcad.py makes it):
paper/tcad/*.aux
paper/tcad/*.bbl
paper/tcad/*.blg
paper/tcad/*.log
paper/tcad/*.out
paper/tcad/*.synctex.gz
paper/tcad/main.pdf
paper/tcad/supplement.pdf
paper/tcad/dist/
